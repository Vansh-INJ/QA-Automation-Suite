# --- API Health Suite specific env vars ---
# Copy relevant lines into your main .env, or set as CI secrets.

BASE_URL=https://injin-dev.injtechnologies.com

# Dedicated "employee" identity used to log in for /api/me/* checks.
# Recommend a dedicated non-human test account rather than a real employee's
# credentials, so password rotations/offboarding don't silently break the suite.
HEALTH_USER_USERNAME=amit.sharma@company.com
HEALTH_USER_PASSWORD=Password@123

# Optional: Slack incoming webhook URL. If unset, the suite still runs and
# reports to Excel/JUnit, it just won't push a chat alert on failure.
HEALTH_SLACK_WEBHOOK_URL=


# --- Mailer (set HEALTH_MAIL_ENABLED=true to activate) ---
HEALTH_MAIL_ENABLED=true
HEALTH_SMTP_HOST=smtp.gmail.com
HEALTH_SMTP_PORT=587
HEALTH_SMTP_USERNAME=you@company.com
HEALTH_SMTP_PASSWORD=your_app_password_here
HEALTH_MAIL_FROM=you@company.com
HEALTH_MAIL_TO=you@company.com,teammate@company.com
HEALTH_MAIL_SUBJECT_PREFIX=[API Health]
